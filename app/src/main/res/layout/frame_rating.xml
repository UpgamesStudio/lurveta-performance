<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_marginTop="6dp"
        android:layout_marginLeft="10dp"
        android:gravity="center_vertical"
        android:background="@drawable/lv_hud_background">

        <LinearLayout
            android:id="@+id/LLFPSPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="11dp"
                android:text="FPS:"
                android:textColor="#00c8f5"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:layout_marginRight="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="11dp"
                android:text="0"
                android:textColor="#EDF2F7"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/LLLowsPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="11dp"
                android:text="1% LOW:"
                android:textColor="#8A6CFF"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:layout_marginRight="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="11dp"
                android:text="-"
                android:textColor="#EDF2F7"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/LLGPUPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="11dp"
                android:text="GPU:"
                android:textColor="#FF5A6A"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:layout_marginRight="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="11dp"
                android:text="0"
                android:textColor="#EDF2F7"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/LLRAMPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="11dp"
                android:text="RAM:"
                android:textColor="#2BD9A0"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:layout_marginRight="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="11dp"
                android:text="0"
                android:textColor="#EDF2F7"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/LLCPUPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="11dp"
                android:text="CPU:"
                android:textColor="#FFB547"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:layout_marginRight="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="11dp"
                android:text="0"
                android:textColor="#EDF2F7"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/LLTempPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textSize="11dp"
                android:text="TEMP:"
                android:textColor="#FF8A3D"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:layout_marginRight="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="11dp"
                android:text="-"
                android:textColor="#EDF2F7"
                android:includeFontPadding="false"
                android:maxLines="1" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>