<?xml version="1.0" encoding="utf-8"?>
<!-- LURVETA library card: cover with the game icon, title, container and actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:orientation="vertical"
        android:background="@drawable/file_grid_item_background">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="112dp"
            android:background="@drawable/lv_cover_background">

            <ImageView
                android:id="@+id/ImageView"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <TextView
            android:id="@+id/TVTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/TVSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:textSize="12sp"
            android:ellipsize="end"
            android:textColor="?attr/colorSecondaryText"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <ImageView
                android:id="@+id/BTRun"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginRight="6dp"
                android:background="@drawable/lv_btn_run_wide"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:tint="?attr/lvOnAccent"
                android:contentDescription="@string/run"
                android:src="@drawable/icon_run" />

            <ImageView
                android:id="@+id/BTMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/lv_btn_ghost_outline"
                android:clickable="true"
                android:focusable="true"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:tint="?attr/colorSecondaryText"
                android:contentDescription="@string/settings"
                android:src="@drawable/icon_list_item_menu" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
