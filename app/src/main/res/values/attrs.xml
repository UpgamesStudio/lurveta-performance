<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="value" format="float" />
    <attr name="minValue" format="integer|float" />
    <attr name="maxValue" format="integer|float" />
    <attr name="step" format="integer|float" />
    <attr name="textSize" format="dimension" />
    <attr name="colorPrimaryText" format="color" />
    <attr name="colorSecondaryText" format="color" />
    <attr name="colorSecondarySurface" format="color" />
    <attr name="toolboxBackground" format="reference" />
    <attr name="preloaderBackground" format="reference" />
    <attr name="progressBarIndeterminateImage" format="reference" />
    <!-- LURVETA design system tokens (resolved per theme, see styles.xml). -->
    <attr name="lvSurfaceCard" format="color" />
    <attr name="lvSurfaceRaised" format="color" />
    <attr name="lvSurfaceInput" format="color" />
    <attr name="lvSurfacePressed" format="color" />
    <attr name="lvStroke" format="color" />
    <attr name="lvStrokeStrong" format="color" />
    <attr name="lvTextTertiary" format="color" />
    <attr name="lvIconTint" format="color" />
    <attr name="lvAccentSoft" format="color" />
    <attr name="lvAccentSoftStrong" format="color" />
    <attr name="lvOnAccent" format="color" />
    <attr name="lvHeaderBackground" format="color" />
    <attr name="lvDialogBackground" format="reference" />
    <declare-styleable name="NumberPicker">
        <attr name="value" />
        <attr name="minValue" />
        <attr name="maxValue" />
        <attr name="step" />
        <attr name="textSize" />
    </declare-styleable>
    <declare-styleable name="SeekBar">
        <attr name="value" />
        <attr name="minValue" />
        <attr name="maxValue" />
        <attr name="step" />
        <attr name="suffix" format="string" />
        <attr name="textSize" />
    </declare-styleable>
</resources>