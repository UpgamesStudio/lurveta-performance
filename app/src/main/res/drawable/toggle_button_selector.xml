<?xml version="1.0" encoding="utf-8"?>
<!-- LURVETA switch: cyan track when on, graphite when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:top="4dp" android:bottom="4dp" android:left="6dp" android:right="6dp">
                <shape android:shape="rectangle"><solid android:color="?attr/colorAccent" /><corners android:radius="12dp" /></shape>
            </item>
            <item android:gravity="right|center_vertical" android:right="9dp" android:width="18dp" android:height="18dp">
                <shape android:shape="oval"><solid android:color="@color/lv_on_cyan" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp" android:bottom="4dp" android:left="6dp" android:right="6dp">
                <shape android:shape="rectangle"><solid android:color="?attr/lvSurfaceInput" /><stroke android:width="1dp" android:color="?attr/lvStrokeStrong" /><corners android:radius="12dp" /></shape>
            </item>
            <item android:gravity="left|center_vertical" android:left="9dp" android:width="18dp" android:height="18dp">
                <shape android:shape="oval"><solid android:color="?attr/colorSecondaryText" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
