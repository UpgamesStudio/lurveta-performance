<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer header: deep black with a soft cyan glow and a hairline separator. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><color android:color="@color/lv_header" /></item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="85%" android:centerX="0.0" android:centerY="0.0"
                android:startColor="#2600C8F5" android:endColor="#0000C8F5" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="1dp"><color android:color="#1FFFFFFF" /></item>
</layer-list>
