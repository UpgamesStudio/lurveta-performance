<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation drawer item: soft cyan pill when selected, graphite pill when pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:insetLeft="12dp" android:insetRight="12dp" android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle"><solid android:color="?attr/lvAccentSoft" /><corners android:radius="14dp" /></shape>
        </inset>
    </item>
    <item android:state_pressed="true">
        <inset android:insetLeft="12dp" android:insetRight="12dp" android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle"><solid android:color="?attr/lvSurfacePressed" /><corners android:radius="14dp" /></shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
