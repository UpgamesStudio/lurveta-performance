<?xml version="1.0" encoding="utf-8"?>
<!-- List item entrance (RecyclerView layoutAnimation): 8% slide + fade. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:interpolator/decelerate_quad">
    <translate android:fromYDelta="8%" android:toYDelta="0" android:duration="220" />
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="220" />
</set>
